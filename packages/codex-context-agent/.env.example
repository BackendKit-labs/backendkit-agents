# Required
CODEX_API_KEY=your-api-key-here

# Optional — LLM provider (default: deepseek)
# CODEX_PROVIDER=deepseek      # deepseek | openai | anthropic | ollama
# CODEX_MODEL=deepseek-reasoner
# CODEX_BASE_URL=https://api.deepseek.com/v1

# Optional — project root (default: CWD when the server starts)
# CODEX_PROJECT_PATH=/path/to/your/project

# Optional — enable HTTP transport alongside stdio
# CODEX_HTTP_PORT=3200
