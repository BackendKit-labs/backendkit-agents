# Required: LLM API key
CURATOR_API_KEY=sk-...

# Required: Absolute path to the vault (where notes are written)
CURATOR_OUTPUT_PATH=/absolute/path/to/vault

# Optional: Input directory for direct analysis
# If set, analyzes code once and exits
# If not set, runs in watch mode (vault/incoming)
CURATOR_INPUT_PATH=/absolute/path/to/project

# Optional: LLM provider (deepseek, openai, anthropic, ollama)
CURATOR_PROVIDER=deepseek

# Optional: Specific model to use
# Defaults:
#   deepseek  → deepseek-reasoner (recommended for reasoning)
#   openai    → o3-mini
#   anthropic → claude-opus-4-8
CURATOR_MODEL=deepseek-reasoner

# Optional: Custom LLM base URL
# Examples:
#   DeepSeek:  https://api.deepseek.com/v1
#   OpenAI:    https://api.openai.com/v1
#   Ollama:    http://localhost:11434/v1
CURATOR_BASE_URL=https://api.deepseek.com/v1

# Optional: HTTP port for MCP server
# If set, runs HTTP MCP server on this port
# If not set, uses stdio transport
CURATOR_PORT=3101

# Optional: Polling interval in milliseconds (watch mode only)
CURATOR_POLL_MS=30000
