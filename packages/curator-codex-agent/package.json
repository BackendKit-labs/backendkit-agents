{
  "name": "@backendkit-labs/curator-codex-agent",
  "version": "0.2.0",
  "description": "Codex Curator — intelligent source code analysis and knowledge extraction into enterprise vaults using LLM reasoning.",
  "main": "dist/server.js",
  "bin": {
    "curator-codex-agent": "./dist/server.js",
    "curator-codex-watcher": "./dist/watcher.js",
    "curator-codex-http": "./dist/http-server-main.js"
  },
  "files": [
    "dist/",
    "AGENT.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BackendKit-labs/backendkit-agents.git",
    "directory": "packages/curator-codex-agent"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "exports": {
    ".": "./dist/index.js",
    "./providers": "./dist/providers/index.js"
  },
  "scripts": {
    "build": "tsc --noCheck",
    "dev": "tsx src/analyzer.ts",
    "start": "node -r dotenv/config dist/server.js",
    "watch-code": "node -r dotenv/config dist/watcher.js",
    "http-server": "node -r dotenv/config dist/http-server-main.js",
    "http-dev": "tsx src/http-server-main.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.55.0",
    "@backendkit-labs/agent-core": "^0.20.2",
    "@backendkit-labs/agent-enterprise": "^0.3.6",
    "@backendkit-labs/console-animations": "^0.1.3",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "dotenv": "^16.4.5",
    "express": "^4.18.0",
    "express-rate-limit": "^7.1.0",
    "openai": "^4.0.0",
    "winston": "^3.11.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  }
}
