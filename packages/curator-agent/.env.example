# Curator Agent Configuration
# Copy this file to .env and fill in the values
# Or set these as environment variables when running the agent

# ==== API Keys (REQUIRED) ====
CURATOR_API_KEY=sk-...

# ==== Paths (REQUIRED) ====
CURATOR_VAULT_PATH=/path/to/vault
# Example:
# CURATOR_VAULT_PATH=C:\Users\mairon.cuello\development\workspace-ia\agent-framework-examples\bk-agent-vault

# ==== Input Source (OPTIONAL) ====
# If set: read documents directly from this path
# If not set: watch vault/incoming/ automatically
CURATOR_INPUT_PATH=/path/to/documents
# Example (for bk-agent docs):
# CURATOR_INPUT_PATH=C:\Users\mairon.cuello\development\workspace-ia\agent-framework-examples\bk-agent\documentation

# ==== Provider Configuration (OPTIONAL) ====
# Provider options: deepseek, openai, ollama, anthropic
# Default: deepseek
CURATOR_PROVIDER=deepseek

# Model selection (depends on provider)
# deepseek default: deepseek-reasoner (or deepseek-chat for faster processing)
# openai default: o3-mini
# ollama default: qwen2.5-coder:7b
# anthropic default: claude-opus-4-8
CURATOR_MODEL=deepseek-reasoner

# ==== Advanced (OPTIONAL) ====
# Override the provider's base URL (useful for custom endpoints)
# CURATOR_BASE_URL=https://api.deepseek.com/v1

# Start HTTP webhook server on this port (for n8n / automation)
# Comment out to disable
# CURATOR_HTTP_PORT=3099

# Vault polling interval in milliseconds (for watcher mode)
# Default: 30000 (30 seconds)
CURATOR_POLL_MS=30000

# ==== For bk-agent vault processing ====
# If using this for bk-agent documentation:
# CURATOR_API_KEY=sk-your-deepseek-key
# CURATOR_VAULT_PATH=C:\Users\mairon.cuello\development\workspace-ia\agent-framework-examples\bk-agent-vault
# CURATOR_PROVIDER=deepseek
# CURATOR_MODEL=deepseek-reasoner
