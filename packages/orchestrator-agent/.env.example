# ── LLM Providers ─────────────────────────────────────────────────────────────

# DeepSeek (cloud — used by writer-agent, architect-agent, data-analyst-agent, risk-agent)
DEEPSEEK_API_KEY=

# Ollama (local — used by hr-agent, it-agent, legal-agent)
# Default: http://localhost:11434  — override only if Ollama runs on a different host
# OLLAMA_HOST=http://localhost:11434

# ── Orchestrator config ────────────────────────────────────────────────────────

# Path to the orchestrator config file (default: ./orchestrator.yaml)
# ORCHESTRATOR_CONFIG=./orchestrator.yaml

# ── HTTP Event Trigger (n8n / external systems) ────────────────────────────────
# Set ORCHESTRATOR_HTTP_PORT to enable the HTTP trigger server.
# Both vars must be set — if either is missing the HTTP server does not start.
#
# Endpoints once running:
#   GET  /health            — liveness check
#   POST /run               — { task, flow_id?, payload? }  → { runId, status }
#   GET  /status/:runId     — poll status (use in n8n Wait node)
#   POST /approve           — { run_id, approved, notes? }  → resume or stop
#
# ORCHESTRATOR_HTTP_PORT=3000
# ORCHESTRATOR_API_KEY=change-me-in-production   # recommended; if unset all requests accepted
