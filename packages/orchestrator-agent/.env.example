# ── LLM Providers ─────────────────────────────────────────────────────────────

# DeepSeek (cloud — used by writer-agent, architect-agent, data-analyst-agent, risk-agent)
DEEPSEEK_API_KEY=

# Ollama (local — used by hr-agent, it-agent, legal-agent)
# Default: http://localhost:11434  — override only if Ollama runs on a different host
# OLLAMA_HOST=http://localhost:11434

# ── Orchestrator config ────────────────────────────────────────────────────────

# Path to the orchestrator config file (default: ./orchestrator.yaml)
# ORCHESTRATOR_CONFIG=./orchestrator.yaml
